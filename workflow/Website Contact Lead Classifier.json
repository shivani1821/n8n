    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this website contact-us query.\n\nName: {{ $('Normalize Contact Details').item.json.name }}\nEmail: {{ $('Normalize Contact Details').item.json.email }}\nPhone: {{ $('Normalize Contact Details').item.json.phone }}\nQuery: {{ $('Normalize Contact Details').item.json.query }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You triage inbound leads from a company's website contact form.\nAssign exactly one label:\n- Hot: urgent, needs an immediate reply (e.g. ready to buy now, critical issue, explicit urgency or deadline).\n- Warm: not urgent yet, but genuine interest that could become urgent (e.g. exploring options, asking pricing, planning soon).\n- Cold: not important (e.g. spam, irrelevant, vague, job seekers, sales pitches to us).\nIf unsure between two labels, pick the less urgent one. If the query is empty or unreadable, use Cold.\nAlso write a one-line summary (max 20 words) of what the person wants."
            }
          ]
        },
        "batching": {}
      },
